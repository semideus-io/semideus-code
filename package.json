{
  "name": "semideus-code",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "daimon": "bun packages/cli/src/main.ts",
    "build": "bun scripts/build.ts",
    "build:npm": "bun scripts/build-npm.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "bun test",
    "smoke": "bun scripts/smoke.ts",
    "verify": "bun run check && bun run typecheck && bun test",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/bun": "^1.3.14",
    "@types/diff": "^8.0.0",
    "@types/react": "^19.2.17",
    "typescript": "^7.0.2"
  }
}
